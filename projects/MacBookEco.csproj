                      OutputItemType="CompanionExecutable" />
    <ProjectReference Include="MacBookEco.Watchdog.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="CompanionExecutable" />
  </ItemGroup>

  <Target Name="EmbedCompanionExecutables" BeforeTargets="BeforeResGen">
    <Error Condition="'@(CompanionExecutable)' == ''"
           Text="Admin and Watchdog outputs are required embedded resources." />
    <ItemGroup>
      <EmbeddedResource Include="@(CompanionExecutable)"
                        Type="Non-Resx"
                        WithCulture="false">
        <LogicalName>%(Filename)%(Extension)</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
  </Target>
